# Non-secret deployment shape. Store real values in the EC2 deployment environment
# and AWS Secrets Manager; never commit them.
ECR_REGISTRY=000000000000.dkr.ecr.us-east-2.amazonaws.com
IMAGE_TAG=full-40-character-git-sha
API_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/waterflex-api@sha256:64-hex-digest
WORKER_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/waterflex-worker@sha256:64-hex-digest
WEB_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/waterflex-web@sha256:64-hex-digest
CloudflareAccess__Issuer=https://your-team.cloudflareaccess.com
CloudflareAccess__Audience=cloudflare-access-application-audience
WATERFLEX_TLS_CERTIFICATE_PATH=/etc/waterflex/tls/origin.pem
WATERFLEX_TLS_PRIVATE_KEY_PATH=/etc/waterflex/tls/origin.key
