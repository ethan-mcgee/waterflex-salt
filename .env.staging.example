# Non-secret deployment shape. Store real values in the EC2 deployment environment
# and AWS Secrets Manager; never commit them.
ECR_REGISTRY=000000000000.dkr.ecr.us-east-2.amazonaws.com
IMAGE_TAG=full-40-character-git-sha
API_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/waterflex-api@sha256:64-hex-digest
WORKER_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/waterflex-worker@sha256:64-hex-digest
WEB_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/waterflex-web@sha256:64-hex-digest
CloudflareAccess__Issuer=https://your-team.cloudflareaccess.com
CloudflareAccess__Audience=cloudflare-access-application-audience
FactoryProvisioning__Enabled=true
FactoryProvisioning__Model=Arduino Nano ESP32
FactoryProvisioning__ApprovedFirmwareVersion=wf-uart-pilot-0.1
FactoryProvisioning__ConfigurationVersion=factory-v2
FactoryProvisioning__HelperBaseUrl=http://127.0.0.1:8765
FactoryProvisioning__HelperProtocolVersion=1
AWS_REGION=us-east-2
StaffProvisioning__Enabled=false
StaffProvisioning__CognitoUserPoolId=us-east-2_example
StaffProvisioning__CloudflareAccountId=cloudflare-account-id
# Inject this value from AWS Secrets Manager at deploy time; do not store the real token here.
StaffProvisioning__CloudflareApiToken=secret-manager-injected-value
StaffProvisioning__CloudflareSecretId=waterflex/staging/staff-provisioning
StaffProvisioning__CloudflarePrivilegedGroupId=cloudflare-privileged-access-group-id
StaffProvisioning__CloudflareDealerGroupId=cloudflare-dealer-access-group-id
# Used only when both staff identities and invitations are empty.
StaffProvisioning__BootstrapAdministratorEmail=first.admin@example.com
StaffProvisioning__BootstrapAdministratorDisplayName=First Administrator
WATERFLEX_TLS_CERTIFICATE_PATH=/etc/waterflex/tls/origin.pem
WATERFLEX_TLS_PRIVATE_KEY_PATH=/etc/waterflex/tls/origin.key
